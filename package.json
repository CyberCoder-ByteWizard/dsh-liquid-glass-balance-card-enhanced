{
  "name": "dsh-liquid-glass-balance-card-enhanced",
  "version": "0.2.0",
  "description": "Enhanced fork of dsh-liquid-glass-balance-card: a draggable liquid-glass floating card for the DSH web GUI with official DeepSeek balance, cumulative spend and per-model token usage from platform.deepseek.com, plus 7 card themes.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "author": "sooodaaa (original author) and contributors",
  "contributors": [
    {
      "name": "sooodaaa",
      "url": "https://github.com/SoDaZilla-zzz"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberCoder-ByteWizard/dsh-liquid-glass-balance-card-enhanced.git"
  },
  "bugs": {
    "url": "https://github.com/CyberCoder-ByteWizard/dsh-liquid-glass-balance-card-enhanced/issues"
  },
  "homepage": "https://github.com/CyberCoder-ByteWizard/dsh-liquid-glass-balance-card-enhanced",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "balance",
    "quota",
    "usage",
    "liquid-glass",
    "draggable",
    "themes"
  ],
  "license": "MIT"
}
